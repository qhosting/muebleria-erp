generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model clientes {
  id                                       String                         @id
  codigoCliente                            String                         @unique
  fechaVenta                               DateTime
  nombreCompleto                           String
  telefono                                 String?
  vendedor                                 String?
  cobradorAsignadoId                       String?
  productoId                               String?
  sucursalId                               String?
  statusCuenta                             StatusCuenta                   @default(activo)
  direccionCompleta                        String
  descripcionProducto                      String
  diaPago                                  String
  montoPago                                Decimal                        @db.Decimal(10, 2)
  periodicidad                             Periodicidad
  saldoActual                              Decimal                        @db.Decimal(10, 2)
  importe1                                 Decimal?                       @db.Decimal(10, 2)
  importe2                                 Decimal?                       @db.Decimal(10, 2)
  importe3                                 Decimal?                       @db.Decimal(10, 2)
  importe4                                 Decimal?                       @db.Decimal(10, 2)
  dni                                      String?
  email                                    String?
  calle                                    String?
  numeroExterior                           String?
  numeroInterior                           String?
  colonia                                  String?
  ciudad                                   String?
  estado                                   String?
  codigoPostal                             String?
  referenciaDireccion                      String?
  fechaNacimiento                          DateTime?
  estadoCivil                              String?
  genero                                   String?
  ocupacion                                String?
  empresaTrabajo                           String?
  telefonoTrabajo                          String?
  ingresosMensuales                        Decimal?                       @db.Decimal(10, 2)
  limiteCredito                            Decimal?                       @db.Decimal(10, 2)
  formaPago                                String?
  datosBancarios                           Json?
  observaciones                            String?
  zona                                     String?
  createdAt                                DateTime                       @default(now())
  updatedAt                                DateTime
  diasVencidos                             Int                            @default(0)
  saldoVencido                             Decimal                        @default(0) @db.Decimal(10, 2)
  equipoId                                 String?
  vendedorId                               String?
  piezas                                   Int                            @default(1)
  users_clientes_cobradorAsignadoIdTousers users?                         @relation("clientes_cobradorAsignadoIdTousers", fields: [cobradorAsignadoId], references: [id])
  equipos_ventas                           equipos_ventas?                @relation(fields: [equipoId], references: [id])
  productos                                productos?                     @relation(fields: [productoId], references: [id])
  sucursales                               sucursales?                    @relation(fields: [sucursalId], references: [id])
  users_clientes_vendedorIdTousers         users?                         @relation("clientes_vendedorIdTousers", fields: [vendedorId], references: [id])
  convenios_pagos                          convenios_pagos[]
  motararios                               motararios[]
  movimientos_bancarios                    movimientos_bancarios[]
  pagos                                    pagos[]
  tickets                                  tickets[]
  verificaciones_domiciliarias             verificaciones_domiciliarias[]
}

model configuracion_sistema {
  id             String   @id
  clave          String   @unique
  empresa        Json
  cobranza       Json
  notificaciones Json
  sincronizacion Json
  impresion      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

model convenios_pagos {
  id            String   @id
  clienteId     String
  gestorId      String
  tipoConvenio  String
  monto         Float
  fecha         DateTime
  comentario    String?
  latitud       String?
  longitud      String?
  fechaRegistro DateTime @default(now())
  clientes      clientes @relation(fields: [clienteId], references: [id])
  users         users    @relation(fields: [gestorId], references: [id])
}

model equipos_ventas {
  id                                          String                @id
  nombre                                      String                @unique
  liderId                                     String?
  isActive                                    Boolean               @default(true)
  createdAt                                   DateTime              @default(now())
  updatedAt                                   DateTime
  clientes                                    clientes[]
  users_equipos_ventas_liderIdTousers         users?                @relation("equipos_ventas_liderIdTousers", fields: [liderId], references: [id])
  presupuestos_ventas                         presupuestos_ventas[]
  users_users_equipoMiembroIdToequipos_ventas users[]               @relation("users_equipoMiembroIdToequipos_ventas")
}

model leads {
  id            String     @id
  nombre        String
  telefono      String?
  direccionArea String?
  interes       String?
  montoEstimado Decimal?   @db.Decimal(10, 2)
  estado        EstadoLead @default(nuevo)
  origen        OrigenLead @default(cambaceo)
  vendedorId    String
  notas         String?
  fechaContacto DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  users         users      @relation(fields: [vendedorId], references: [id])
}

model motararios {
  id            String          @id
  clienteId     String
  cobradorId    String
  motivo        MotivoMotarario
  descripcion   String
  fecha         DateTime        @default(now())
  proximaVisita DateTime?
  localId       String?
  sincronizado  Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  clientes      clientes        @relation(fields: [clienteId], references: [id])
  users         users           @relation(fields: [cobradorId], references: [id])
}

model movimientos_bancarios {
  id                   String    @id
  legacyId             Int?      @unique
  bancoOrigen          String
  fechaOperacion       DateTime
  horaOperacion        DateTime? @db.Time(6)
  descripcionGeneral   String?
  cargo                Float?
  abono                Float?
  saldo                Float?
  referencia           String?
  claveRastreo         String?
  concepto             String?
  descripcionDetallada String?
  fechaIngreso         DateTime  @default(now())
  ticketId             String?
  clienteId            String?
  fechaIdentificado    DateTime?
  clientes             clientes? @relation(fields: [clienteId], references: [id])
  tickets              tickets?  @relation(fields: [ticketId], references: [id])
}

model movimientos_inventario {
  id                                                              String         @id
  productoId                                                      String
  tipoMovimiento                                                  TipoMovimiento
  cantidad                                                        Int
  sucursalOrigenId                                                String?
  sucursalDestinoId                                               String?
  motivo                                                          String?
  referencia                                                      String?
  usuarioId                                                       String?
  createdAt                                                       DateTime       @default(now())
  productos                                                       productos      @relation(fields: [productoId], references: [id])
  sucursales_movimientos_inventario_sucursalDestinoIdTosucursales sucursales?    @relation("movimientos_inventario_sucursalDestinoIdTosucursales", fields: [sucursalDestinoId], references: [id])
  sucursales_movimientos_inventario_sucursalOrigenIdTosucursales  sucursales?    @relation("movimientos_inventario_sucursalOrigenIdTosucursales", fields: [sucursalOrigenId], references: [id])
}

model pagos {
  id            String   @id
  clienteId     String
  cobradorId    String
  monto         Decimal  @db.Decimal(10, 2)
  concepto      String?
  tipoPago      TipoPago @default(regular)
  fechaPago     DateTime @default(now())
  saldoAnterior Decimal  @db.Decimal(10, 2)
  saldoNuevo    Decimal  @db.Decimal(10, 2)
  metodoPago    String   @default("gestor")
  numeroRecibo  String?
  localId       String?
  ticketImpreso Boolean  @default(false)
  sincronizado  Boolean  @default(false)
  createdAt     DateTime @default(now())
  banco         String?
  latitud       String?
  longitud      String?
  ticketId      String?
  clientes      clientes @relation(fields: [clienteId], references: [id])
  users         users    @relation(fields: [cobradorId], references: [id])
  tickets       tickets? @relation(fields: [ticketId], references: [id])
}

model pending_tickets {
  id          String   @id
  remitente   String   @unique
  base64Data  String
  tipoArchivo String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model plantillas_ticket {
  id        String        @id
  nombre    String        @unique
  contenido String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime
  tipo      TipoPlantilla @default(ticket)
}

model presupuestos_ventas {
  id             String          @id
  metaMonto      Decimal         @db.Decimal(10, 2)
  metaPiezas     Int
  vendedorId     String?
  equipoId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  fechaFin       DateTime
  fechaInicio    DateTime
  nombre         String?
  metaLeads      Int             @default(0)
  equipos_ventas equipos_ventas? @relation(fields: [equipoId], references: [id])
  users          users?          @relation(fields: [vendedorId], references: [id])
}

model productos {
  id                     String                   @id
  codigo                 String                   @unique
  nombre                 String
  descripcion            String?
  categoria              String?
  precioCompra           Decimal                  @db.Decimal(10, 2)
  precioVenta            Decimal                  @db.Decimal(10, 2)
  unidadMedida           String                   @default("pieza")
  stockMinimo            Int                      @default(0)
  imagenUrl              String?
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  clientes               clientes[]
  movimientos_inventario movimientos_inventario[]
  stock                  stock[]
}

model rutas_cobranza {
  id                String   @id
  cobradorId        String
  fecha             DateTime
  clientesVisitados Json
  totalCobrado      Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  users             users    @relation(fields: [cobradorId], references: [id])
}

model sesiones_caja {
  id            String    @id
  userId        String
  fecha         DateTime  @default(now())
  apertura      DateTime?
  cierre        DateTime?
  montoInicial  Decimal   @default(0) @db.Decimal(10, 2)
  montoFinal    Decimal?  @db.Decimal(10, 2)
  totalCobrado  Decimal   @default(0) @db.Decimal(10, 2)
  estatus       String    @default("abierto")
  observaciones String?
  users         users     @relation(fields: [userId], references: [id])
}

model stock {
  id         String     @id
  productoId String
  sucursalId String
  cantidad   Int        @default(0)
  updatedAt  DateTime
  productos  productos  @relation(fields: [productoId], references: [id])
  sucursales sucursales @relation(fields: [sucursalId], references: [id])

  @@unique([productoId, sucursalId])
}

model sucursales {
  id                                                                          String                   @id
  nombre                                                                      String                   @unique
  direccion                                                                   String?
  telefono                                                                    String?
  esBodega                                                                    Boolean                  @default(false)
  isActive                                                                    Boolean                  @default(true)
  createdAt                                                                   DateTime                 @default(now())
  updatedAt                                                                   DateTime
  clientes                                                                    clientes[]
  movimientos_inventario_movimientos_inventario_sucursalDestinoIdTosucursales movimientos_inventario[] @relation("movimientos_inventario_sucursalDestinoIdTosucursales")
  movimientos_inventario_movimientos_inventario_sucursalOrigenIdTosucursales  movimientos_inventario[] @relation("movimientos_inventario_sucursalOrigenIdTosucursales")
  stock                                                                       stock[]
}

model tickets {
  id                    String                  @id
  legacyId              Int?                    @unique
  clienteId             String?
  gestorId              String?
  monto                 Float
  referencia            String?
  folio                 String?
  fecha                 DateTime?
  creadoEn              DateTime                @default(now())
  conciliado            Boolean                 @default(false)
  urlComprobante        String?
  concepto              String?
  cuentaOrigen          String?
  cuentaDestino         String?
  claveRastreo          String?
  remitente             String?
  movimientos_bancarios movimientos_bancarios[]
  pagos                 pagos[]
  clientes              clientes?               @relation(fields: [clienteId], references: [id])
  users                 users?                  @relation(fields: [gestorId], references: [id])
}

model users {
  id                                                   String                         @id
  email                                                String                         @unique
  name                                                 String
  password                                             String?
  role                                                 UserRole                       @default(cobrador)
  codigoGestor                                         String?
  isActive                                             Boolean                        @default(true)
  createdAt                                            DateTime                       @default(now())
  updatedAt                                            DateTime
  impresoraNombre                                      String?
  impresoraAnchoPapel                                  Int?                           @default(80)
  impresoraTamanoFuente                                String?                        @default("mediana")
  impresoraAutoImprimir                                Boolean?                       @default(false)
  conciliado                                           Boolean                        @default(false)
  horaCierre                                           DateTime?
  equipoMiembroId                                      String?
  Account                                              Account[]
  Session                                              Session[]
  clientes_clientes_cobradorAsignadoIdTousers          clientes[]                     @relation("clientes_cobradorAsignadoIdTousers")
  clientes_clientes_vendedorIdTousers                  clientes[]                     @relation("clientes_vendedorIdTousers")
  convenios_pagos                                      convenios_pagos[]
  equipos_ventas_equipos_ventas_liderIdTousers         equipos_ventas[]               @relation("equipos_ventas_liderIdTousers")
  leads                                                leads[]
  motararios                                           motararios[]
  pagos                                                pagos[]
  presupuestos_ventas                                  presupuestos_ventas[]
  rutas_cobranza                                       rutas_cobranza[]
  sesiones_caja                                        sesiones_caja[]
  tickets                                              tickets[]
  equipos_ventas_users_equipoMiembroIdToequipos_ventas equipos_ventas?                @relation("users_equipoMiembroIdToequipos_ventas", fields: [equipoMiembroId], references: [id])
  verificaciones_domiciliarias                         verificaciones_domiciliarias[]
}

model verificaciones_domiciliarias {
  id            String   @id
  clienteId     String
  gestorId      String
  fecha         DateTime
  detallesExtra Json?
  fechaRegistro DateTime @default(now())
  clientes      clientes @relation(fields: [clienteId], references: [id])
  users         users    @relation(fields: [gestorId], references: [id])
}

enum EstadoLead {
  nuevo
  contactado
  negociacion
  convertido
  descartado
}

enum MotivoMotarario {
  no_estaba
  sin_dinero
  viajo
  enfermo
  otro
}

enum OrigenLead {
  cambaceo
  facebook
  referido
  oficina
  otro
}

enum Periodicidad {
  semanal
  quincenal
  mensual
  diario
  catorcenal
}

enum StatusCuenta {
  activo
  inactivo
}

enum TipoMovimiento {
  entrada
  salida
  traspaso
  ajuste
  venta
}

enum TipoPago {
  regular
  moratorio
  abono
  liquidacion
  mora
  congelado
  otro
}

enum TipoPlantilla {
  ticket
  bienvenida
}

enum UserRole {
  admin
  gestor_cobranza
  reporte_cobranza
  cobrador
  vendedor
  jefe_ventas
}
