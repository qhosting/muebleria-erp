
# ============================================
# EASYPANEL - MUEBLERÍA LA ECONÓMICA
# Variables de Entorno
# ============================================

# Node Environment
NODE_ENV=production
PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# HOST debe ser el nombre del servicio PostgreSQL en EasyPanel
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@muebleria-postgres:5432/muebleria

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# La URL de tu aplicación en EasyPanel
NEXTAUTH_URL=https://erp.vertexmuebles.com

# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=GENERA_UN_SECRET_SEGURO_AQUI

# ============================================
# JWT CONFIGURATION
# ============================================
# Generar con: openssl rand -base64 32
JWT_SECRET=GENERA_UN_SECRET_SEGURO_AQUI

# ============================================
# WEB PUSH (VAPID) CONFIGURATION
# ============================================
# Se usan para las notificaciones Push de la PWA
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=PON_TU_LLAVE_PUBLICA_AQUI
VAPID_PRIVATE_KEY=PON_TU_LLAVE_PRIVADA_AQUI

# ============================================
# INTEGRACIONES (CONTPAQI & WHATSAPP)
# ============================================
CONTPAQI_API_URL=http://vortex520.qhosting.net:5000
CONTPAQI_API_KEY=VERTEX123_CONTPAQI_ERP_2024
CONTPAQI_CONCEPTO_ABONO=ABONO CLIENTE

WAHA_API_URL=https://tu-servidor-waha.com
WAHA_API_KEY=tu-llave-waha-aqui
WAHA_SESSION_NAME=default

# ============================================
# AI SERVICES
# ============================================
OPENAI_API_KEY=tu-llave-openai-aqui
GEMINI_API_KEY=tu-llave-gemini-aqui

# ============================================
# INSTRUCCIONES
# ============================================
#
# 1. Copia este archivo y renómbralo a .env.easypanel
# 2. Reemplaza todos los valores que dicen "TU_" o "GENERA_"
# 3. Para generar secrets seguros, ejecuta en tu terminal:
#    openssl rand -base64 32
# 4. NO COMPARTAS este archivo en Git (ya está en .gitignore)
#
# ============================================
